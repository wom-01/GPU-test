{% extends '@EasyAdmin/page/content.html.twig' %}

{% block title %}| 支付设置{% endblock %}

{% block responsive_header_logo %}
    <a class="responsive-logo" title="{{ ea.dashboardTitle|striptags }}" href="{{ path('panel') }}">
        {{ ea.dashboardTitle|raw }}
    </a>
{% endblock %}

{% block header_logo %}
    <a class="logo" title="{{ ea.dashboardTitle|striptags }}" href="{{ path('panel') }}">
        <span class="logo-custom">{{ ea.dashboardTitle|raw }}</span>
        <span class="logo-compact"><i class="fas fa-home"></i></span>
    </a>
{% endblock %}

{% block content %}
    <div class="payment-settings-page mt-4">
        <div class="payment-settings-header mb-4">
            <div>
                <h3 class="mb-1"><i class="fas fa-credit-card me-2"></i>支付设置</h3>
                <p class="mb-0">集中配置人民币充值、易支付和 Stripe，无需逐条编辑。</p>
            </div>
        </div>

        <form method="post" class="payment-settings-panel">
            <input type="hidden" name="_token" value="{{ csrf_token('payment_settings') }}">

            <div class="payment-tabs" role="tablist">
                <button type="button" class="payment-tab active" data-payment-tab="general">通用设置</button>
                <button type="button" class="payment-tab" data-payment-tab="epay">
                    易支付
                    <span class="status-dot {{ epayConfigured ? 'configured' : '' }}"></span>
                </button>
                <button type="button" class="payment-tab" data-payment-tab="stripe">
                    Stripe
                    <span class="status-dot {{ stripeConfigured ? 'configured' : '' }}"></span>
                </button>
            </div>

            <div class="payment-tab-panel active" data-payment-panel="general">
                <div class="payment-info"><i class="fas fa-circle-info"></i>客户充值统一以人民币结算。</div>
                <div class="payment-fields">
                    <label class="payment-field">
                        <span>余额单位</span>
                        <input name="internal_currency_name" value="{{ settings.internal_currency_name|default('元') }}" required>
                        <small>显示在余额、商品价格和订单金额后面，例如“元”。</small>
                    </label>
                    <label class="payment-field">
                        <span>货币代码</span>
                        <input name="currency_name" value="{{ settings.currency_name|default('CNY') }}" required>
                        <small>人民币请填写 CNY。</small>
                    </label>
                    <label class="payment-field">
                        <span>最低充值金额</span>
                        <div class="payment-input-suffix">
                            <input type="number" min="0.01" step="0.01" name="minimum_topup_amount" value="{{ settings.minimum_topup_amount|default('1.00') }}" required>
                            <b>元</b>
                        </div>
                        <small>客户单次充值不能低于此金额。</small>
                    </label>
                </div>
            </div>

            <div class="payment-tab-panel" data-payment-panel="epay">
                <div class="payment-info"><i class="fas fa-circle-info"></i>支付宝和微信支付共用这一套易支付商户配置。</div>
                <div class="payment-fields payment-fields-three">
                    <label class="payment-field">
                        <span>支付接口地址</span>
                        <input type="url" name="epay_url" value="{{ settings.epay_url|default('') }}" placeholder="https://pay.example.com">
                        <small>填写易支付平台首页地址，不要填写 submit.php。</small>
                    </label>
                    <label class="payment-field">
                        <span>商户 ID（PID）</span>
                        <input name="epay_pid" value="{{ settings.epay_pid|default('') }}" placeholder="例如：1000">
                        <small>易支付后台提供的商户编号。</small>
                    </label>
                    <label class="payment-field">
                        <span>商户密钥（KEY）</span>
                        <input type="password" name="epay_key" autocomplete="new-password" placeholder="{{ epayConfigured ? '已配置，留空则不修改' : '请输入商户密钥' }}">
                        <small>敏感信息不会在页面中显示。</small>
                    </label>
                </div>
            </div>

            <div class="payment-tab-panel" data-payment-panel="stripe">
                <div class="payment-info"><i class="fas fa-circle-info"></i>国内收款只使用易支付时，Stripe 可以保持为空。</div>
                <div class="payment-fields">
                    <label class="payment-field">
                        <span>Stripe 密钥</span>
                        <input type="password" name="stripe_secret_key" autocomplete="new-password" placeholder="{{ stripeConfigured ? '已配置，留空则不修改' : 'sk_live_...' }}">
                    </label>
                    <label class="payment-field">
                        <span>支付方式</span>
                        <input name="stripe_payment_methods" value="{{ settings.stripe_payment_methods|default('card') }}" placeholder="card">
                        <small>多个方式使用英文逗号分隔。</small>
                    </label>
                </div>
            </div>

            <div class="payment-settings-actions">
                <button type="submit" class="btn btn-primary"><i class="fas fa-check me-2"></i>保存支付设置</button>
            </div>
        </form>
    </div>

    <script>
        document.querySelectorAll('[data-payment-tab]').forEach((tab) => {
            tab.addEventListener('click', () => {
                document.querySelectorAll('[data-payment-tab], [data-payment-panel]').forEach((item) => item.classList.remove('active'));
                tab.classList.add('active');
                document.querySelector(`[data-payment-panel="${tab.dataset.paymentTab}"]`).classList.add('active');
            });
        });
    </script>
{% endblock %}
