{% extends '@EasyAdmin/page/content.html.twig' %}

{% block title %}| 实名认证配置{% endblock %}

{% block content %}
<div class="payment-settings-page mt-4">
    <div class="payment-settings-header mb-4">
        <div>
            <h3 class="mb-1"><i class="fas fa-id-card me-2"></i>实名认证配置</h3>
            <p class="mb-0">配置阿里云金融级实人认证，启用后客户订购 GPU 前必须完成人脸核验。</p>
        </div>
    </div>

    <form method="post" class="payment-settings-panel">
        <input type="hidden" name="_token" value="{{ csrf_token('identity_settings') }}">
        <div class="payment-tab-panel active">
            <div class="payment-info"><i class="fas fa-circle-info"></i>请使用独立 RAM 用户凭证，不要填写阿里云主账号 AccessKey。</div>
            <div class="payment-fields">
                <label class="payment-field">
                    <span>AccessKey ID</span>
                    <input type="password" name="aliyun_cloudauth_access_key_id" autocomplete="new-password" placeholder="{{ accessKeyIdConfigured ? '已配置，留空则不修改' : '请输入 AccessKey ID' }}">
                    <small>阿里云 RAM 用户的 AccessKey ID。</small>
                </label>
                <label class="payment-field">
                    <span>AccessKey Secret</span>
                    <input type="password" name="aliyun_cloudauth_access_key_secret" autocomplete="new-password" placeholder="{{ accessKeySecretConfigured ? '已配置，留空则不修改' : '请输入 AccessKey Secret' }}">
                    <small>敏感信息不会在页面中回显。</small>
                </label>
                <label class="payment-field">
                    <span>SceneId（认证场景 ID）</span>
                    <input name="aliyun_cloudauth_scene_id" value="{{ settings.aliyun_cloudauth_scene_id|default('') }}" placeholder="请输入阿里云认证场景 ID">
                    <small>在阿里云金融级实人认证控制台创建认证场景后获取。</small>
                </label>
                <label class="identity-enable-setting">
                    <span><b>强制实名认证</b><small>启用后，未认证客户不能进入 GPU 配置页或提交订单。</small></span>
                    <input type="checkbox" name="aliyun_real_name_enabled" value="1" {{ enabled ? 'checked' : '' }}>
                </label>
            </div>
        </div>
        <div class="payment-settings-actions">
            <button type="submit" class="btn btn-primary"><i class="fas fa-check me-2"></i>保存实名认证设置</button>
        </div>
    </form>
</div>
{% endblock %}
