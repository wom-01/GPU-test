{% extends 'layout/base.html.twig' %}

{% block body %}
    {{ include('components/hero.html.twig') }}
    <section class="marketplace-section" id="marketplace">
        <div class="container">
            <div class="marketplace-heading">
                <div><span>COMPUTE MARKETPLACE</span><h2>热门 GPU 算力</h2><p>选择适合工作负载的实例，购买后在客户中心查看连接信息。</p></div>
                <a href="{{ path('landing_store') }}" class="marketplace-all">查看全部配置 <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="market-tabs" aria-label="商品分类">
                <a class="active" href="#marketplace"><i class="fas fa-microchip"></i> 全部算力</a>
                {% for category in categories %}<a href="{{ path('landing_store', {'category': category.id}) }}">{{ category.name }}</a>{% endfor %}
            </div>
            {{ include('components/featured-products.html.twig', { products: featuredProducts }) }}
        </div>
    </section>
    {{ include('components/cta-section.html.twig') }}
{% endblock %}
